# ===============================
# train_strong.py  —  Competition-grade trainer (EfficientNet-B7)
# ===============================
# Features:
# • Transfer learning on EfficientNet-B7 (timm)
# • Progressive unfreezing (head → last 3 blocks)
# • Strong augmentations + Mixup/CutMix
# • SoftTargetCrossEntropy (for mixup)
# • AdamW + cosine schedule option OR ReduceLROnPlateau
# • Early stopping + best checkpointing
# • EMA (exponential moving average) for stabler validation
# • Class index mapping saved to JSON (used by inference)
# • Deterministic seeds for reproducibility

import os
import json
import math
import random
from pathlib import Path

import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader
from torchvision import datasets, transforms

import timm
from timm.data.mixup import Mixup
from timm.loss import SoftTargetCrossEntropy
from timm.optim import AdamW
from timm.scheduler.cosine_lr import CosineLRScheduler
from timm.utils import ModelEmaV2

from torch.optim.lr_scheduler import ReduceLROnPlateau

# --------------------- Config ---------------------
class CFG:
    train_dir = "bird_dataset/train"
    val_dir   = "bird_dataset/val"
    out_dir   = "outputs"
    model_name = "efficientnet_b7"
    img_size   = 600
    batch_size = 8               # B7 is heavy; increase only if GPU allows
    num_workers = 4
    epochs = 25
    unfreeze_epoch = 5           # progressively unfreeze deeper layers at this epoch
    lr_head = 1e-4
    lr_finetune = 1e-5
    weight_decay = 1e-4
    use_cosine = True            # if False, fallback to ReduceLROnPlateau
    mixup_alpha = 0.2
    cutmix_alpha = 1.0
    mixup_prob = 0.4
    label_smoothing = 0.0        # not used with SoftTargetCrossEntropy
    early_stop_patience = 6
    ema_decay = 0.9998
    seed = 42

# --------------------- Utils ---------------------
def set_seed(seed: int = 42):
    random.seed(seed)
    os.environ["PYTHONHASHSEED"] = str(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark = False


def build_transforms(img_size: int):
    train_tfms = transforms.Compose([
        transforms.RandomResizedCrop(img_size),
        transforms.RandomHorizontalFlip(),
        transforms.ColorJitter(brightness=0.3, contrast=0.3, saturation=0.3, hue=0.2),
        transforms.RandomRotation(20),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
    ])
    val_tfms = transforms.Compose([
        transforms.Resize(img_size + 20),
        transforms.CenterCrop(img_size),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
    ])
    return train_tfms, val_tfms


def save_class_mapping(dataset: datasets.ImageFolder, out_dir: str):
    idx_to_class = {int(v): k for k, v in dataset.class_to_idx.items()}
    Path(out_dir).mkdir(parents=True, exist_ok=True)
    with open(Path(out_dir) / "idx_to_class.json", "w") as f:
        json.dump(idx_to_class, f, indent=2)


def progressive_unfreeze(model: nn.Module, num_blocks: int = 3):
    # Unfreeze last `num_blocks` children (excluding classifier)
    blocks = [m for m in model.children()][:-1]
    for block in blocks[-num_blocks:]:
        for p in block.parameters():
            p.requires_grad = True


def train():
    set_seed(CFG.seed)

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print("Using", device)

    train_tfms, val_tfms = build_transforms(CFG.img_size)

    train_ds = datasets.ImageFolder(CFG.train_dir, transform=train_tfms)
    val_ds   = datasets.ImageFolder(CFG.val_dir, transform=val_tfms)

    train_loader = DataLoader(train_ds, batch_size=CFG.batch_size, shuffle=True,
                              num_workers=CFG.num_workers, pin_memory=True)
    val_loader   = DataLoader(val_ds, batch_size=CFG.batch_size, shuffle=False,
                              num_workers=CFG.num_workers, pin_memory=True)

    num_classes = len(train_ds.classes)
    print("Classes:", train_ds.classes)
    save_class_mapping(train_ds, CFG.out_dir)

    # Model
    model = timm.create_model(CFG.model_name, pretrained=True, num_classes=num_classes)

    # Freeze all
    for p in model.parameters():
        p.requires_grad = False
    # Unfreeze classifier head
    for p in model.get_classifier().parameters():
        p.requires_grad = True

    model.to(device)

    # Mixup/CutMix
    mixup_fn = Mixup(mixup_alpha=CFG.mixup_alpha, cutmix_alpha=CFG.cutmix_alpha,
                     prob=CFG.mixup_prob, switch_prob=0.5, mode='batch', num_classes=num_classes)

    # Loss & Optimizer
    criterion = SoftTargetCrossEntropy()
    optimizer = AdamW(filter(lambda p: p.requires_grad, model.parameters()),
                      lr=CFG.lr_head, weight_decay=CFG.weight_decay)

    # EMA for stability
    model_ema = ModelEmaV2(model, decay=CFG.ema_decay) if device.type == 'cuda' else None

    # Schedulers
    num_steps = CFG.epochs * math.ceil(len(train_loader))
    if CFG.use_cosine:
        scheduler = CosineLRScheduler(optimizer, t_initial=num_steps, lr_min=CFG.lr_head * 0.01,
                                      warmup_t=min(1000, num_steps // 10), warmup_lr_init=CFG.lr_head * 0.1,
                                      t_in_epochs=False)
        plateau = None
    else:
        scheduler = None
        plateau = ReduceLROnPlateau(optimizer, mode='max', factor=0.5, patience=2, verbose=True)

    best_acc = 0.0
    patience_ctr = 0

    global_step = 0
    for epoch in range(CFG.epochs):
        model.train()
        run_loss, correct, total = 0.0, 0, 0

        # Progressive unfreezing at CFG.unfreeze_epoch
        if epoch == CFG.unfreeze_epoch:
            progressive_unfreeze(model, num_blocks=3)
            optimizer = AdamW(filter(lambda p: p.requires_grad, model.parameters()),
                              lr=CFG.lr_finetune, weight_decay=CFG.weight_decay)
            # Reset scheduler for new lr
            if CFG.use_cosine:
                num_steps_remaining = (CFG.epochs - epoch) * math.ceil(len(train_loader))
                scheduler = CosineLRScheduler(optimizer, t_initial=num_steps_remaining,
                                              lr_min=CFG.lr_finetune * 0.01,
                                              warmup_t=min(800, num_steps_remaining // 12),
                                              warmup_lr_init=CFG.lr_finetune * 0.1,
                                              t_in_epochs=False)
            else:
                plateau = ReduceLROnPlateau(optimizer, mode='max', factor=0.5, patience=2, verbose=True)

        for images, labels in train_loader:
            images = images.to(device, non_blocking=True)
            labels = labels.to(device, non_blocking=True)

            # Mixup/CutMix returns mixed inputs and soft targets
            images, targets = mixup_fn(images, labels)

            optimizer.zero_grad(set_to_none=True)
            outputs = model(images)
            loss = criterion(outputs, targets)
            loss.backward()
            optimizer.step()

            if model_ema:
                model_ema.update(model)

            run_loss += loss.item()
            # compute hard accuracy for logging (argmax vs labels)
            with torch.no_grad():
                preds = outputs.argmax(1)
                # For mixed targets, convert to hard labels for estimation only
                hard_targets = labels
                correct += (preds == hard_targets).sum().item()
                total += labels.size(0)

            if CFG.use_cosine and scheduler is not None:
                scheduler.step(global_step)
            global_step += 1

        train_acc = 100.0 * correct / max(total, 1)

        # Validation (use EMA if exists)
        model.eval()
        eval_model = model_ema.module if model_ema else model
        eval_model.eval()

        val_correct, val_total = 0, 0
        with torch.no_grad():
            for images, labels in val_loader:
                images = images.to(device, non_blocking=True)
                labels = labels.to(device, non_blocking=True)
                outputs = eval_model(images)
                preds = outputs.argmax(1)
                val_total += labels.size(0)
                val_correct += (preds == labels).sum().item()

        val_acc = 100.0 * val_correct / max(val_total, 1)

        if not CFG.use_cosine and plateau is not None:
            plateau.step(val_acc)

        print(f"Epoch {epoch+1:02d}/{CFG.epochs} | Loss {run_loss/len(train_loader):.4f} | Train {train_acc:.2f}% | Val {val_acc:.2f}%")

        # Checkpointing
        Path(CFG.out_dir).mkdir(parents=True, exist_ok=True)
        torch.save(model.state_dict(), Path(CFG.out_dir)/"last.pth")
        if model_ema:
            torch.save(model_ema.module.state_dict(), Path(CFG.out_dir)/"last_ema.pth")

        if val_acc > best_acc:
            best_acc = val_acc
            patience_ctr = 0
            torch.save(model.state_dict(), Path(CFG.out_dir)/"best.pth")
            if model_ema:
                torch.save(model_ema.module.state_dict(), Path(CFG.out_dir)/"best_ema.pth")
            print("✅ Saved new best model")
        else:
            patience_ctr += 1
            if patience_ctr >= CFG.early_stop_patience:
                print("⏹ Early stopping")
                break

    print(f"Best Val Acc: {best_acc:.2f}%")


if __name__ == "__main__":
    train()


# ===============================
# infer_submit.py  —  Inference + CSV export with TTA
# ===============================
# • Loads best checkpoint & class mapping
# • Runs Test-Time Augmentation (original + horizontal flip)
# • Writes predictions to predictions.csv (filename, class_name)

import csv
from typing import List, Tuple

from PIL import Image
from torch.utils.data import Dataset

class ImageFolderNoLabels(Dataset):
    def __init__(self, root: str, transform=None):
        self.root = Path(root)
        self.paths = sorted([p for p in self.root.rglob('*') if p.suffix.lower() in {'.jpg','.jpeg','.png','.bmp','.webp'}])
        self.transform = transform
    def __len__(self):
        return len(self.paths)
    def __getitem__(self, idx):
        path = self.paths[idx]
        img = Image.open(path).convert('RGB')
        return img, str(path)


def build_infer_transforms(img_size: int):
    base = transforms.Compose([
        transforms.Resize(img_size + 20),
        transforms.CenterCrop(img_size),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
    ])
    hflip = transforms.Compose([
        transforms.Resize(img_size + 20),
        transforms.CenterCrop(img_size),
        transforms.functional.hflip,
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
    ])
    return [base, hflip]


def load_model(checkpoint_path: str, idx_to_class_path: str, model_name: str = CFG.model_name):
    with open(idx_to_class_path, 'r') as f:
        idx_to_class = json.load(f)
    num_classes = len(idx_to_class)
    model = timm.create_model(model_name, pretrained=False, num_classes=num_classes)
    sd = torch.load(checkpoint_path, map_location='cpu')
    model.load_state_dict(sd, strict=True)
    model.eval()
    return model, idx_to_class


def predict_tta(model: nn.Module, images: List[Image.Image], tta_tfms: List[transforms.Compose], device) -> torch.Tensor:
    # Average logits over TTA variants
    logits_accum = None
    for tfm in tta_tfms:
        batch = torch.stack([tfm(img) if callable(getattr(tfm, '__call__', None)) else tfm(img) for img in images])
        batch = batch.to(device)
        with torch.no_grad():
            logits = model(batch)
        logits_accum = logits if logits_accum is None else (logits_accum + logits)
    return logits_accum / len(tta_tfms)


def run_inference(test_dir: str = "bird_dataset/test", checkpoint: str = "outputs/best_ema.pth", out_csv: str = "predictions.csv"):
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print("Using", device)

    idx_to_class_path = Path("outputs")/"idx_to_class.json"
    if not Path(checkpoint).exists():
        # Fallback to non-EMA best
        checkpoint = "outputs/best.pth"
    model, idx_to_class = load_model(checkpoint, str(idx_to_class_path), model_name=CFG.model_name)
    model.to(device)

    tta_tfms = build_infer_transforms(CFG.img_size)

    ds = ImageFolderNoLabels(test_dir)
    loader = DataLoader(ds, batch_size=CFG.batch_size, shuffle=False, num_workers=CFG.num_workers, pin_memory=True, collate_fn=lambda x: x)

    rows: List[Tuple[str,str]] = []
    for batch in loader:
        imgs, paths = zip(*batch)
        logits = predict_tta(model, list(imgs), tta_tfms, device)
        preds = logits.argmax(1).cpu().tolist()
        for pth, pred in zip(paths, preds):
            rows.append((os.path.basename(pth), idx_to_class[str(pred)]))

    with open(out_csv, 'w', newline='') as f:
        writer = csv.writer(f)
        writer.writerow(["filename", "label"])  # adjust header if platform expects different
        writer.writerows(rows)
    print(f"✅ Wrote {len(rows)} predictions to {out_csv}")


if __name__ == "__main__":
    # Example usage:
    # python infer_submit.py -- after training, ensure outputs/best_ema.pth or outputs/best.pth exists
    run_inference()
